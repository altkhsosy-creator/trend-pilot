yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Sensitive files — never commit
backend/env_ready.txt
backend/.env
.env


# ===== TrendPilot rebuild additions (Aug 31 2026) =====
# Secrets — never commit any .env variant
backend/.env.backup_*
*.env.backup_*

# Python cache
__pycache__/
*.pyc

# Manual code backups (cp file file.backup_TIMESTAMP convention)
*.backup_*

# Generated content — audio, video, subtitles, weekly output
backend/weekly_content/
backend/data/
backend/*.mp3
backend/*.mp4
backend/*.srt
test_*.py

# Local virtual environment
venv/

# Local tar.gz archive backups
*.tar.gz
